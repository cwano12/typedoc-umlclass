{
    "name": "typedoc-umlclass-mod",
    "version": "0.7.0",
    "description": "Plugin for TypeDoc that generates UML class diagrams",
    "author": {
        "name": "Christopher Wano",
        "url": "https://github.com/cwano12"
    },
    "license": "ISC",
    "keywords": [
        "uml",
        "typedoc",
        "typedocplugin"
    ],
    "dependencies": {
        "decorator-cache-getter": "^1.0.0",
        "plantuml-encoder": "^1.4.0",
        "plantuml-pipe": "^1.6.0",
        "progress": "^2.0.3",
        "queue-fifo": "^0.2.6"
    },
    "devDependencies": {
        "@types/node": "22.14.1",
        "@types/plantuml-encoder": "1.4.2",
        "@types/progress": "2.0.7",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "eslint": "9.25.1",
        "eslint-plugin-import": "2.31.0",
        "eslint-plugin-jsdoc": "50.6.11",
        "eslint-plugin-unicorn": "58.0.0",
        "prettier": "3.5.3",
        "rimraf": "6.0.1",
        "typedoc": "0.28.20",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.73.0"
    },
    "peerDependencies": {
        "typedoc": "0.28.x"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cwano12/typedoc-umlclass.git"
    },
    "main": "dist/index.js",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "lint": "eslint ./src",
        "format": "prettier --check ./src ./test",
        "clean": "rimraf dist",
        "build": "tsc",
        "clean-build": "npm run clean && npm run build",
        "test": "npm run build && node --test test/*.test.mjs",
        "prepack": "npm run clean-build"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "types": "dist/index.d.ts"
}
